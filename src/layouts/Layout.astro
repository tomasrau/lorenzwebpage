---
import '../styles/global.css';

const baseUrl = import.meta.env.BASE_URL;

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "Lorenz — Tecnología Financiera, Business Intelligence y Automatización",
  description = "Diseñamos sistemas de información, automatización y control financiero para convertir datos dispersos en decisiones ejecutivas claras y accionables.",
  canonicalURL = Astro.url.href,
  ogImage = new URL(`${baseUrl}og-image.png`, Astro.site).href,
  noindex = false
} = Astro.props;

const faviconUrl = `${baseUrl}lorenz-favicon.png`;
const favicon32Url = `${baseUrl}favicon-32.png`;
const appleTouchIconUrl = `${baseUrl}apple-touch-icon.png`;
const sitemapUrl = new URL(`${baseUrl}sitemap.xml`, Astro.site).href;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32Url} />
    <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIconUrl} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href={sitemapUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body id="top" class="min-h-full flex flex-col bg-brand-bg text-brand-slate antialiased">
    <slot />
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const revealTargets = document.querySelectorAll(
          'section:not(#hero):not(#enfoque) h2, section:not(#hero):not(#enfoque) h3, section:not(#hero):not(#enfoque) article, section:not(#hero):not(#enfoque) .rounded-xl, section:not(#hero):not(#enfoque) .rounded-2xl'
        );

        revealTargets.forEach((element, index) => {
          element.setAttribute('data-reveal', '');
          element.setAttribute('data-reveal-delay', String(index % 3));
        });

        if (!reduceMotion) {
          document.documentElement.classList.add('motion-ready');
          const revealObserver = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
          revealTargets.forEach((element) => revealObserver.observe(element));
        }

        const themedSections = document.querySelectorAll('[data-scroll-theme]');
        const themeObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              document.body.style.setProperty('--page-theme', entry.target.getAttribute('data-scroll-theme'));
            }
          });
        }, { threshold: 0.2, rootMargin: '-35% 0px -35% 0px' });
        themedSections.forEach((section) => themeObserver.observe(section));
      })();
    </script>
  </body>
</html>
