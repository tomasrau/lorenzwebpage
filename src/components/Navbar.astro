---
import logoDark from '../media/logos/LOGO_black_no_bg_no_desc_trimmed.png';
import logoLight from '../media/logos/LOGO_white_no_bg_no_desc_trimmed.png';
---

<header id="main-header" class="nav-header fixed top-0 left-0 right-0 z-50 text-brand-dark">
  <div class="max-w-[1440px] mx-auto px-6 md:px-10 h-full flex items-center justify-between">
    <a href="#top" class="relative block w-[126px] md:w-[144px] group">
      <img src={logoDark.src} width="398" height="103" alt="Lorenz" class="nav-logo-dark w-full h-auto transition-all duration-300 group-hover:scale-[1.02]" />
      <img src={logoLight.src} width="399" height="102" alt="" class="nav-logo-light absolute inset-0 w-full h-auto opacity-0 transition-all duration-300 group-hover:scale-[1.02]" />
    </a>

    <nav class="hidden lg:flex items-center gap-7">
      <a href="#enfoque">Enfoque</a>
      <a href="#soluciones">Soluciones</a>
      <a href="#servicios">Servicios</a>
      <a href="#metodologia">Método</a>
      <a href="#casos">Casos</a>
    </nav>

    <a href="#contacto" class="nav-cta hidden md:inline-flex items-center justify-center px-5 py-2.5 text-xs font-semibold rounded-full text-white bg-brand-dark hover:bg-brand-accent transition-colors">
      Solicitar diagnóstico
    </a>

    <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-brand-accent" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M4 7h16M4 12h16M4 17h16"></path>
        <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden absolute top-full left-4 right-4 bg-white/95 text-brand-dark border border-brand-border-dark rounded-2xl shadow-2xl backdrop-blur-xl opacity-0 -translate-y-2 transition-all duration-300">
    <nav class="flex flex-col p-5 gap-1">
      <a href="#enfoque" class="mobile-nav-link">Enfoque</a>
      <a href="#soluciones" class="mobile-nav-link">Soluciones</a>
      <a href="#servicios" class="mobile-nav-link">Servicios</a>
      <a href="#metodologia" class="mobile-nav-link">Método</a>
      <a href="#casos" class="mobile-nav-link">Casos</a>
      <a href="#contacto" class="mobile-nav-link mt-3 text-center !text-white !bg-brand-accent">Solicitar diagnóstico</a>
    </nav>
  </div>
</header>

<style>
  .nav-header { height:80px; border-bottom:1px solid transparent; transition:height .35s ease,background-color .5s ease,border-color .5s ease,color .5s ease,backdrop-filter .5s ease; }
  .nav-header nav a { font-size:.75rem; font-weight:600; color:currentColor; opacity:.68; transition:opacity .25s ease,color .25s ease; }
  .nav-header nav a:hover { opacity:1; }
  .nav-header.is-scrolled { height:64px; background:rgba(246,246,243,.82); border-color:rgba(217,217,212,.75); backdrop-filter:blur(18px); }
  .nav-header.is-dark { color:white; }
  .nav-header.is-dark.is-scrolled { background:rgba(16,16,18,.82); border-color:rgba(255,255,255,.1); }
  .nav-header.is-dark .nav-logo-dark { opacity:0; }
  .nav-header.is-dark .nav-logo-light { opacity:1; }
  .nav-header.is-dark .nav-cta { color:#111113; background:white; }
  .mobile-nav-link { padding:.8rem 1rem; border-radius:.8rem; font-size:.9rem!important; opacity:1!important; }
  .mobile-nav-link:hover { background:#f0edf6; }
</style>

<script>
  const header = document.getElementById('main-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function updateHeaderPosition() {
    header?.classList.toggle('is-scrolled', window.scrollY > 24);
  }

  const navThemeObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        header?.classList.toggle('is-dark', entry.target.getAttribute('data-nav-theme') === 'dark');
      }
    });
  }, { rootMargin: '-48px 0px -85% 0px', threshold: 0 });

  document.querySelectorAll('[data-nav-theme]').forEach((section) => navThemeObserver.observe(section));
  window.addEventListener('scroll', updateHeaderPosition, { passive: true });
  updateHeaderPosition();

  function toggleMenu() {
    if (!menuBtn || !menu || !hamburgerIcon || !closeIcon) return;
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    if (!isExpanded) {
      menu.classList.remove('hidden');
      requestAnimationFrame(() => menu.classList.remove('opacity-0', '-translate-y-2'));
      hamburgerIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    } else {
      menu.classList.add('opacity-0', '-translate-y-2');
      hamburgerIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
      setTimeout(() => menu.classList.add('hidden'), 300);
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  navLinks.forEach((link) => link.addEventListener('click', toggleMenu));
</script>
