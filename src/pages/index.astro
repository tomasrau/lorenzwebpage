---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/Problem.astro';
import ValueProp from '../components/ValueProp.astro';
import Services from '../components/Services.astro';
import UseCases from '../components/UseCases.astro';
import Methodology from '../components/Methodology.astro';
import ConsultingValue from '../components/ConsultingValue.astro';
import Trust from '../components/Trust.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout>
  <!-- Main sticky header -->
  <Navbar />
  
  <!-- Content sections -->
  <main class="flex-grow">
    <Hero />
    <ConsultingValue />
    <Problem />
    <ValueProp />
    <Services />
    <UseCases />
    <Methodology />
    <Trust />
    <Contact />
  </main>

  <WhatsAppButton />

  <!-- Global Footer -->
  <Footer />
</Layout>
