---
const whatsappUrl = 'https://wa.me/message/Q4LZOLT235M4D1';
---

<a
  id="whatsapp-button"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar a Lorenz por WhatsApp"
  class="whatsapp-button fixed right-5 bottom-5 md:right-8 md:bottom-8 z-40 w-14 h-14 md:w-16 md:h-16 rounded-full bg-[#25D366] text-white shadow-[0_12px_34px_rgba(17,17,19,.26)] grid place-items-center opacity-0 translate-y-4 pointer-events-none transition-all duration-300 hover:scale-105 hover:bg-[#20bd5a] focus:outline-none focus:ring-4 focus:ring-[#25D366]/30"
>
  <svg class="w-7 h-7 md:w-8 md:h-8" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <path d="M16.02 3C8.84 3 3 8.72 3 15.76c0 2.48.73 4.9 2.12 6.96L3.73 27.8l5.23-1.35a13.16 13.16 0 0 0 7.06 2.04C23.2 28.49 29 22.77 29 15.76S23.2 3 16.02 3Zm0 23.34c-2.18 0-4.31-.58-6.17-1.69l-.44-.26-3.1.8.82-3-.29-.46a10.48 10.48 0 0 1-1.69-5.97c0-5.86 4.88-10.62 10.87-10.62 5.98 0 10.84 4.76 10.84 10.62s-4.86 10.58-10.84 10.58Zm5.96-7.92c-.33-.16-1.93-.93-2.23-1.04-.3-.1-.52-.16-.74.16-.22.33-.85 1.04-1.04 1.26-.19.22-.38.24-.71.08-.33-.16-1.38-.5-2.63-1.58a9.83 9.83 0 0 1-1.82-2.22c-.19-.33-.02-.5.14-.66.15-.14.33-.38.49-.57.16-.19.22-.33.33-.55.11-.22.05-.41-.03-.57-.08-.16-.74-1.75-1.01-2.4-.27-.64-.54-.55-.74-.56h-.63c-.22 0-.57.08-.87.41-.3.33-1.14 1.1-1.14 2.68 0 1.58 1.17 3.11 1.33 3.32.16.22 2.3 3.45 5.57 4.84.78.33 1.38.52 1.86.67.78.24 1.49.21 2.05.13.63-.09 1.93-.77 2.2-1.52.27-.76.27-1.41.19-1.55-.08-.13-.3-.21-.63-.37Z"/>
  </svg>
</a>

<script>
  const whatsappButton = document.getElementById('whatsapp-button');
  const hero = document.getElementById('hero');

  function updateWhatsAppVisibility() {
    if (!whatsappButton || !hero) return;
    const showButton = hero.getBoundingClientRect().bottom <= window.innerHeight;
    whatsappButton.classList.toggle('is-visible', showButton);
  }

  window.addEventListener('scroll', updateWhatsAppVisibility, { passive: true });
  window.addEventListener('resize', updateWhatsAppVisibility);
  updateWhatsAppVisibility();
</script>

<style>
  .whatsapp-button.is-visible { opacity:1; transform:translateY(0); pointer-events:auto; }
  @media(prefers-reduced-motion:reduce){.whatsapp-button{transition:none}}
</style>
