---
// ConsultingValue.astro
---

<section id="enfoque" data-scroll-theme="#101012" data-nav-theme="dark" class="relative py-28 md:py-40 text-white overflow-hidden">
  <div class="absolute inset-0 consulting-grid"></div>
  <div class="absolute inset-x-0 top-0 h-48 consulting-veil"></div>
  <div class="absolute -top-48 left-1/2 -translate-x-1/2 w-[900px] h-[520px] rounded-full bg-white/[.055] blur-[140px]"></div>

  <div class="consulting-content max-w-[1440px] mx-auto px-6 md:px-10 relative z-10">
    <div class="consulting-intro grid lg:grid-cols-12 gap-12 lg:gap-20 items-end mb-20 md:mb-28">
      <div class="lg:col-span-7">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-accent">Nuestro enfoque</span>
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-semibold tracking-[-0.06em] leading-[.95] text-white mt-5">
          La tecnología es el medio. Decidir mejor es el objetivo.
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="text-lg text-white/60 leading-relaxed">
          Gestionamos la tecnología y los datos detrás de la información financiera para que la dirección pueda entender el negocio, anticipar desvíos y actuar con criterio.
        </p>
        <p class="text-sm text-white/35 leading-relaxed mt-5">
          No vendemos una plataforma cerrada. Diseñamos e implementamos la solución adecuada para la realidad, las herramientas y el nivel de madurez de cada empresa.
        </p>
      </div>
    </div>

    <div class="consulting-main grid lg:grid-cols-12 gap-5 mb-5">
      <article class="lg:col-span-7 rounded-[2rem] border border-white/10 bg-white/[.035] p-8 md:p-12">
        <span class="text-[10px] uppercase tracking-[.2em] text-white/35">Necesidades recurrentes</span>
        <h3 class="max-w-xl text-3xl md:text-4xl font-medium tracking-[-0.04em] text-white mt-5 mb-10">
          Problemas de gestión que aparecen cuando la empresa crece.
        </h3>

        <div class="divide-y divide-white/10 border-y border-white/10">
          <div class="grid grid-cols-[auto_1fr] gap-5 py-6">
            <span class="text-sm text-brand-accent">01</span>
            <div><h4 class="text-lg font-medium text-white">Información dispersa y poco confiable</h4><p class="text-sm text-white/40 mt-2 leading-relaxed">ERP, bancos, CRM y planillas muestran versiones distintas del mismo negocio.</p></div>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-5 py-6">
            <span class="text-sm text-white/30">02</span>
            <div><h4 class="text-lg font-medium text-white">Reportes que explican tarde</h4><p class="text-sm text-white/40 mt-2 leading-relaxed">La dirección detecta desvíos cuando ya perdió capacidad de respuesta.</p></div>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-5 py-6">
            <span class="text-sm text-white/30">03</span>
            <div><h4 class="text-lg font-medium text-white">Procesos manuales que no escalan</h4><p class="text-sm text-white/40 mt-2 leading-relaxed">El equipo dedica horas a consolidar datos en lugar de analizarlos y gestionarlos.</p></div>
          </div>
        </div>
      </article>

      <article class="lg:col-span-5 rounded-[2rem] border border-white/10 bg-white/[.055] text-white p-8 md:p-12 flex flex-col">
        <span class="text-[10px] uppercase tracking-[.2em] text-brand-accent">Valor agregado Lorenz</span>
        <h3 class="text-3xl md:text-4xl font-medium tracking-[-0.04em] text-white mt-5">
          Unimos negocio, finanzas y tecnología.
        </h3>
        <p class="text-sm text-white/45 leading-relaxed mt-5 max-w-md">
          Traducimos necesidades de gestión en una arquitectura de información útil, sostenible y alineada con la toma de decisiones.
        </p>

        <div class="mt-12 grid gap-3">
          <div class="rounded-2xl border border-white/10 bg-black/10 p-5"><span class="block text-xs text-white/35 uppercase tracking-wider">01 · Criterio</span><strong class="block text-lg font-medium mt-2">Entendemos qué necesita decidir la dirección.</strong></div>
          <div class="rounded-2xl border border-white/10 bg-black/10 p-5"><span class="block text-xs text-white/35 uppercase tracking-wider">02 · Diseño</span><strong class="block text-lg font-medium mt-2">Ordenamos datos, procesos e indicadores.</strong></div>
          <div class="rounded-2xl border border-brand-accent/35 bg-brand-accent/10 p-5"><span class="block text-xs text-brand-accent uppercase tracking-wider">03 · Implementación</span><strong class="block text-lg font-medium mt-2">Integramos la solución en la operación real.</strong></div>
        </div>
      </article>
    </div>

    <div class="consulting-results grid md:grid-cols-3 gap-5">
      <article class="rounded-[2rem] border border-white/10 bg-white/[.035] p-7 md:p-9">
        <span class="text-xs uppercase tracking-[.18em] text-white/30">Resultado</span>
        <h3 class="text-2xl font-medium text-white mt-8 mb-3">Información confiable</h3>
        <p class="text-sm text-white/45 leading-relaxed">Una base común para analizar resultados, caja, costos y operaciones.</p>
      </article>
      <article class="rounded-[2rem] border border-white/10 bg-white/[.035] p-7 md:p-9">
        <span class="text-xs uppercase tracking-[.18em] text-white/30">Resultado</span>
        <h3 class="text-2xl font-medium text-white mt-8 mb-3">Procesos sostenibles</h3>
        <p class="text-sm text-white/45 leading-relaxed">Menos carga manual y más capacidad del equipo para gestionar excepciones.</p>
      </article>
      <article class="rounded-[2rem] border border-white/10 bg-white/[.035] p-7 md:p-9">
        <span class="text-xs uppercase tracking-[.18em] text-brand-accent">Resultado</span>
        <h3 class="text-2xl font-medium text-white mt-8 mb-3">Decisiones con contexto</h3>
        <p class="text-sm text-white/45 leading-relaxed">Indicadores, alertas y análisis diseñados alrededor del negocio.</p>
      </article>
    </div>
  </div>
</section>

<style>
  .consulting-grid { opacity:.22; background-image:linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px);background-size:56px 56px;mask-image:linear-gradient(to bottom,transparent 0%,black 18%,black 70%,transparent 92%); }
  .consulting-veil { z-index:1; background:linear-gradient(to bottom,#101012 0%,rgba(16,16,18,.92) 35%,transparent 100%); }
  .motion-ready .consulting-intro,.motion-ready .consulting-main,.motion-ready .consulting-results { opacity:0; transform:translateY(56px); transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1); }
  .motion-ready .consulting-main { transition-delay:120ms; }
  .motion-ready .consulting-results { transition-delay:220ms; }
  .motion-ready .consulting-content.is-visible .consulting-intro,.motion-ready .consulting-content.is-visible .consulting-main,.motion-ready .consulting-content.is-visible .consulting-results { opacity:1; transform:translateY(0); }
  @media(prefers-reduced-motion:reduce){.motion-ready .consulting-intro,.motion-ready .consulting-main,.motion-ready .consulting-results{opacity:1;transform:none;transition:none}}
</style>

<script>
  const consultingContent = document.querySelector('.consulting-content');

  if (consultingContent) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry?.isIntersecting) {
        consultingContent.classList.add('is-visible');
        observer.disconnect();
      }
    }, { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });

    observer.observe(consultingContent);
  }
</script>
